<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 安全拦截必须放在"物理文件短路"之前：
    # 短路规则会让真实存在的文件（.git/*、.env.*、uploads 下的脚本）直接跳过后面的拦截规则
    # 禁止隐藏文件/目录（.env、.env.local、.git 等；.well-known 供证书签发使用）
    RewriteRule ^\.(?!well-known) - [F,L,NC]
    # 禁止直接访问日志与缓存目录
    RewriteRule ^(logs|cache)(/|$) - [F,L,NC]
    # 禁止执行上传目录中的脚本（纵深防御：即使上传了 .php 也不解析）
    RewriteRule ^assets/uploads/.*\.(php|phtml|php[0-9]|pl|py|cgi|sh)$ - [F,L,NC]

    # Skip physical files and directories from rewrite rules
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # API routes with ID (e.g., /api/wishlists/123/toggle)
    RewriteRule ^api/([^/]+)/(\d+)/([^/]+)$ api/$1-$3.php?id=$2 [L,QSA]

    # API routes (e.g., /api/wishlists)
    RewriteRule ^api/([^/]+)$ api/$1.php [L,QSA]

    # Install route
    RewriteRule ^install/?$ install/index.php [L,QSA]

    # Skip static files
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Main entry points
    RewriteRule ^$ index.php [L,QSA]
    RewriteRule ^index\.php$ index.php [L,QSA]
    RewriteRule ^admin\.php$ admin.php [L,QSA]
    RewriteRule ^admin/?$ admin.php [L,QSA]

    # Router fallback
    RewriteRule ^(.*)$ router.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Cache static assets for 1 week
    <FilesMatch "\.(css|js|woff2?|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>

    # Cache images for 1 month
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Cache fonts for 1 week
    <FilesMatch "\.(woff2?|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# 禁止直接访问敏感文件（.env、.git、日志、缓存、临时文件）
<FilesMatch "^(\.env|\.env\..*|\.gitignore|\.dockerignore|Dockerfile|docker-compose\.yml|CLAUDE\.md|composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml)$">
    Require all denied
</FilesMatch>

# 禁止目录列出
Options -Indexes

# 禁止 PHP 在日志与缓存目录执行（拦截访问见文件头部 RewriteRule）
<FilesMatch "^(cache|logs)">
    <IfModule mod_php.c>
        php_flag engine off
    </IfModule>
</FilesMatch>